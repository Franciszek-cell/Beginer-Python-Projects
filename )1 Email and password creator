print("====Account Creator====")!

while True: #code to input name and last name with validation
    print()
    imię = input("Name: ")
    nazwisko = input("Last Name: ")

    if len(imię) < 1 or len(nazwisko) < 1:
        print()
        print("Name and last name cannot be empty.")
        continue

    elif not imię.islower() or not nazwisko.islower(): 
        print()
        print("Name and last name should be written in lowercase.")
        continue

    elif imię.startswith("@") or nazwisko.endswith("."):
        print()
        print("Name should not start with '@', and last name should not end with a dot.")
        continue

    elif '.com' in imię or '.pl' in imię or '.com' in nazwisko or '.pl' in nazwisko:
        print()
        print("Name and last name should not contain internet domains.")
        continue   

    else:
        email = imię + "." + nazwisko + "@email.com"

        print()
        print("Your details have been successfully entered.")
        print()
        print(f"Name: {imię}, Last Name: {nazwisko}")

        odpowiedź = input("Are the details correct? (yes/no): ")

        if odpowiedź == "yes":
            print()
            print(f"Email address: {email}")
            break
        elif odpowiedź == "no":
            print()
            print("Please enter the details again.")
            continue

print()
print("Now we will generate a password for you.")

while True: #code to input password with validation
    hasło = input("Enter your password: ")

    if len(hasło) < 8:
        print()
        print("Password should have at least 8 characters.")
    elif not any(znak in hasło for znak in "!@#$%^&*()-_=+[]}{;:'\",.<>/?"):
        print()
        print("Password should contain at least one special character.")
    elif not any(znak.isdigit() for znak in hasło):
        print()
        print("Password should contain at least one digit.")
    elif not any(znak.isupper() for znak in hasło):
        print()
        print("Password should contain at least one uppercase letter.")
    elif not any(znak.islower() for znak in hasło):
        print()
        print("Password should contain at least one lowercase letter.")
    else:
        print()
        sprawdzenie = input("Enter the password again to confirm: ")
        if hasło != sprawdzenie:
            print()
            print("Passwords do not match. Please try again.")
            continue
        else:
            print()
            print("Password has been correctly entered.")
            break
print()
print("Account has been successfully created!")
print(f"Your email address: {email}")
print(f"Your password: {hasło}")
print('Thank you for using our account creator!')
